# ==============================================================================
# AutoApply AI — Backend Environment Template
# Copy this file to .env and configure with your credentials
# NEVER commit actual secrets to version control
# ==============================================================================

# Server Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Supabase Credentials (from Supabase Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
# SERVICE_ROLE_KEY is backend-only and should never be exposed to frontend
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key
# Supabase JWT Secret (from Supabase Project Settings -> API -> JWT Settings)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Background Worker & Redis (Phase 2)
REDIS_URL=redis://localhost:6379/0

# Guardrail Feature Flags (Must remain false for Phase 1)
FEATURE_AUTO_APPLY_ENABLED=false
FEATURE_JOB_SCRAPING_ENABLED=false
FEATURE_AI_MATCHING_ENABLED=false
